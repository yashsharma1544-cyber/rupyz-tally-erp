# Copy this file to .env.local in the same directory.
# Get values from Supabase dashboard → Settings → API.

# The URL of your Supabase project (same as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://aiekaymlbfypxnczrvgb.supabase.co

# The SERVICE ROLE key (NOT the anon key). Found in Settings → API → "service_role" key.
# CRITICAL: this key bypasses RLS. Keep it secret. Never commit .env.local to git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...PASTE-YOUR-KEY-HERE

# Where the 4 CSV files live on your machine.
CSV_DIR=C:\Users\Yash\Downloads\rupyz_export

# Set to "true" to dry-run (parse + report what would happen, but don't write to DB)
DRY_RUN=false
